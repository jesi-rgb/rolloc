{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:path:allow-join",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        { "path": "**" }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "**" },
        { "path": "**/.rolloc-meta" },
        { "path": "**/.rolloc-meta/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "**" },
        { "path": "**/.rolloc-meta" },
        { "path": "**/.rolloc-meta/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "**" },
        { "path": "**/.rolloc-meta" },
        { "path": "**/.rolloc-meta/**" }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        { "path": "**" },
        { "path": "**/.rolloc-meta" },
        { "path": "**/.rolloc-meta/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "**" },
        { "path": "**/.rolloc-meta" },
        { "path": "**/.rolloc-meta/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "**" },
        { "path": "**/.rolloc-meta" },
        { "path": "**/.rolloc-meta/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "**" },
        { "path": "**/.rolloc-meta" },
        { "path": "**/.rolloc-meta/**" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "**" },
        { "path": "**/.rolloc-meta" },
        { "path": "**/.rolloc-meta/**" }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        { "path": "**" },
        { "path": "**/.rolloc-meta" },
        { "path": "**/.rolloc-meta/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "**" },
        { "path": "**/.rolloc-meta" },
        { "path": "**/.rolloc-meta/**" }
      ]
    },
    "updater:default"
  ]
}
